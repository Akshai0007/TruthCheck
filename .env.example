# Copy this file to ".env" (same folder as app.py) and fill in your values.
# ".env" is listed in .gitignore. Never put real API keys in this example file or commit your .env file.

# Which provider the web app / command line starts with: groq, openai or gemini
TRUTHCHECK_PROVIDER=groq

# One key per provider (leave the ones you do not use empty)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional fallback key for any provider without its own variable above
TRUTHCHECK_API_KEY=

# Models are chosen automatically (see DEFAULT_CHAINS in truthcheck/llm.py): if one is busy or unavailable,
# the next is tried. To change the order, uncomment a line below (comma separated, first = preferred).
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant
# OPENAI_MODELS=gpt-5.4-mini,gpt-6-luna,gpt-5.6-luna,gpt-5.4-nano
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
